    },
    {
      "id": "hang",
      "description": "按支架/螺母组件临时挂装后固定，检查设备水平和与吊顶关系"
    },
    {
      "id": "connect",
      "description": "保持接口防扭，安装匹配阀组和辅助接水盘，完成保温及排气"
    },
    {
      "id": "drain",
      "description": "按手册核对提升高度、下游坡度、支撑和错误存气/虹吸位置"
    },
    {
      "id": "inspect",
      "description": "投运前检查固定、接地、水路密封、排水畅通；按手册进行排水泵、停泵回流及浮子关阀功能核验"
    }
  ],
